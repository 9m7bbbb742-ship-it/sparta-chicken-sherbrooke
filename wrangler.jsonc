{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sparta-chicken-sherbrooke",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sparta-chicken-db",
      "database_id": "d3848bc5-4155-46c3-90ab-bbd7feffba6c"
    }
  ]
}